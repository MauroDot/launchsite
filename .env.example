# Required for Prisma and PostgreSQL. Replace these placeholders in a local .env file.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/launchsite?schema=public"

# Server-only OpenAI API key for structured website-content generation.
OPENAI_API_KEY=""

# Cloudinary direct-upload configuration. Keep the API secret server-side only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public application URL used by future integrations and deployment configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js server secret and Google OAuth credentials.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Initial LaunchSite owner accounts, comma-separated. Never expose this to the browser.
ADMIN_EMAILS="owner@example.com"

# Stripe subscriptions. All four values are server-only; use test-mode values locally.
# Create distinct USD monthly prices: Starter $19 and Business $39.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Server-only key from the dedicated Connect platform account; never reuse the SaaS billing key.
STRIPE_CONNECT_SECRET_KEY=""
# Merchant Connect events use separate signing secrets and endpoints.
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Accounts v2 thin lifecycle events: /api/stripe/connect/webhook?events=accounts
STRIPE_CONNECT_ACCOUNTS_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
STRIPE_FEATURED_BUSINESS_PRICE_ID=""

# Server-only Vercel project-domain management. Never expose the API token to the browser.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# Optional server-only lead notifications through Resend.
RESEND_API_KEY=""
LEAD_NOTIFICATION_FROM="LaunchSite <leads@example.com>"
