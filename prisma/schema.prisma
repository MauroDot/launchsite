generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum UserRole {
  USER
  ADMIN
}

enum BillingPlan {
  FREE
  STARTER
  BUSINESS
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  CLOSED
  SPAM
}

enum LeadSource {
  CONTACT_FORM
}

enum AnalyticsEventType {
  PAGE_VIEW
  LEAD_SUBMITTED
}

enum AnalyticsHostType {
  LAUNCHSITE_SLUG
  CUSTOM_DOMAIN
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  role          UserRole         @default(USER)
  accounts      Account[]
  sessions      Session[]
  projects      WebsiteProject[]
  leadNotes     LeadNote[]
  billingAccount BillingAccount?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model BillingAccount {
  id                          String      @id @default(cuid())
  userId                      String      @unique
  user                        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  stripeCustomerId            String?     @unique
  stripeSubscriptionId        String?     @unique
  stripePriceId               String?
  plan                        BillingPlan @default(FREE)
  subscriptionStatus          String?
  subscriptionCreatedAt       DateTime?
  currentPeriodStart          DateTime?
  currentPeriodEnd            DateTime?
  cancelAtPeriodEnd           Boolean     @default(false)
  checkoutSessionId           String?     @unique
  checkoutAttemptId           String?
  checkoutPlan                BillingPlan?
  checkoutPriceId             String?
  checkoutExpiresAt           DateTime?
  pendingPlan                 BillingPlan?
  pendingPlanEffectiveAt     DateTime?
  stripeSubscriptionScheduleId String?    @unique
  featuredAddonActive        Boolean     @default(false)
  featuredAddonPriceId       String?
  featuredAddonCurrentPeriodEnd DateTime?
  featuredAddonCancelAtPeriodEnd Boolean @default(false)
  featuredAddonScheduleId     String?    @unique
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
}

model StripeWebhookEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WebsiteProject {
  id                    String               @id @default(cuid())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  businessName          String
  businessType          String
  businessDescription   String
  businessStory         String?
  targetAudience        String?
  differentiators       String?
  customerPriorities    String?
  factualNotes          String?
  serviceArea           String
  phone                 String
  email                 String
  yearsInBusiness       Int?
  brandTone             String
  primaryCallToAction   String
  secondaryCallToAction String?
  visualStyle           String
  slug                  String               @unique
  status                ProjectStatus        @default(DRAFT)
  generatedContent      Json?
  contentGeneratedAt    DateTime?
  siteSettings          Json?
  isDemo                Boolean              @default(false)
  featured              Boolean              @default(false)
  demoTitle             String?
  demoDescription       String?
  demoSortOrder         Int?
  isPublished           Boolean              @default(false)
  publishedAt           DateTime?
  lastPublishedAt       DateTime?
  publicSlug            String?              @unique
  seoTitle              String?
  seoDescription        String?
  socialImageUrl        String?
  allowIndexing         Boolean              @default(true)
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  services              WebsiteService[]
  workSamples           WebsiteWorkSample[]
  testimonials          WebsiteTestimonial[]
  featuredBusiness      FeaturedBusiness?
  domain                Domain?
  leads                 Lead[]
  analyticsEvents       AnalyticsEvent[]
  paymentSettings       ProjectPaymentSettings?
  externalPaymentOptions ExternalPaymentOption[]
  paymentItems          PaymentItem[]
  customerPayments      CustomerPayment[]
}

enum ConnectStatus {
  NOT_CONNECTED
  ONBOARDING
  PENDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum ExternalPaymentType {
  PAYPAL
  VENMO
  CASH_APP
  BANK_PAYMENT_LINK
  OTHER
}

enum PaymentItemType {
  FIXED
  DEPOSIT
  CUSTOM_AMOUNT
}

enum CustomerPaymentMethod {
  STRIPE
  PAYPAL
  VENMO
  CASH_APP
  BANK_TRANSFER
  CASH
  CHECK
  OTHER
}

enum CustomerPaymentSource {
  STRIPE
  MANUAL_EXTERNAL
}

enum CustomerPaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
  FAILED
}

// Merchant configuration never uses BillingAccount customer/subscription IDs.
model ProjectPaymentSettings {
  id                     String @id @default(cuid())
  projectId              String @unique
  project                WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  stripeConnectAccountId String? @unique
  stripeConnectStatus    ConnectStatus @default(NOT_CONNECTED)
  stripeChargesEnabled   Boolean @default(false)
  stripePayoutsEnabled   Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)
  accountAttemptAt       DateTime?
  receiptSequence        Int @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ExternalPaymentOption {
  id           String @id @default(cuid())
  projectId    String
  project      WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         ExternalPaymentType
  label        String
  url          String
  instructions String?
  enabled      Boolean @default(true)
  sortOrder    Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([projectId, enabled, sortOrder])
}

model PaymentItem {
  id          String @id @default(cuid())
  projectId   String
  project     WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name        String
  description String?
  amount      Int
  currency    String @default("usd")
  type        PaymentItemType @default(FIXED)
  enabled     Boolean @default(true)
  minAmount   Int @default(50)
  maxAmount   Int @default(1000000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([projectId, enabled])
}

model CustomerPayment {
  id                      String @id @default(cuid())
  projectId               String
  project                 WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  customerName            String
  customerEmail           String?
  customerPhone           String?
  description             String
  businessName            String
  businessEmail           String
  businessPhone           String
  subtotal                Int
  taxAmount               Int @default(0)
  discountAmount          Int @default(0)
  totalAmount             Int
  refundedAmount          Int @default(0)
  currency                String @default("usd")
  paymentMethod           CustomerPaymentMethod
  paymentSource           CustomerPaymentSource
  paymentStatus           CustomerPaymentStatus @default(PENDING)
  paidAt                  DateTime?
  externalReference       String?
  note                    String?
  stripeConnectAccountId  String?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeChargeId          String? @unique
  stripeReceiptUrl        String?
  receiptNumber           String?
  receiptToken            String? @unique
  receiptIssuedAt         DateTime?
  requestKey              String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  lineItems               PaymentLineItem[]
  @@unique([projectId, receiptNumber])
  @@unique([projectId, requestKey])
  @@index([projectId, paymentStatus, createdAt])
  @@index([projectId, paymentMethod, createdAt])
}

model PaymentLineItem {
  id          String @id @default(cuid())
  paymentId   String
  payment     CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitAmount  Int
  totalAmount Int
  position    Int
  @@unique([paymentId, position])
}

model ConnectWebhookEvent {
  eventId     String @id
  accountId   String
  eventType   String
  processedAt DateTime @default(now())
}

// Shared, fixed-window limits work across serverless instances.
model PaymentRateLimit {
  key       String @id
  count     Int @default(1)
  resetAt   DateTime
  @@index([resetAt])
}

model Domain {
  id         String       @id @default(cuid())
  projectId  String       @unique
  hostname   String       @unique
  canonical  Boolean      @default(true)
  status     DomainStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  project    WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String     @id @default(cuid())
  projectId String
  name      String
  email     String
  phone     String?
  message   String
  status    LeadStatus @default(NEW)
  source    LeadSource @default(CONTACT_FORM)
  followUpAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notes     LeadNote[]

  @@index([projectId, status, createdAt])
  @@index([followUpAt])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([userId])
}

model AnalyticsEvent {
  id          String             @id @default(cuid())
  projectId   String
  type        AnalyticsEventType
  path        String
  hostType    AnalyticsHostType
  source      String?
  referrer    String?
  visitorKey  String?
  createdAt   DateTime           @default(now())
  project     WebsiteProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, type, createdAt])
  @@index([projectId, visitorKey, createdAt])
}

model FeaturedBusiness {
  id                     String         @id @default(cuid())
  projectId              String         @unique
  project                WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  enabled                Boolean        @default(false)
  displayTitle           String?
  promotionalDescription String?
  imageUrl               String?
  sortOrder              Int?
  startsAt               DateTime?
  endsAt                 DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model WebsiteWorkSample {
  id                 String         @id @default(cuid())
  projectId          String
  project            WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaType          MediaType
  mediaUrl           String
  cloudinaryPublicId String?
  width              Int?
  height             Int?
  duration           Float?
  format             String?
  bytes              Int?
  title              String
  description        String
  serviceCategory    String?
  locationNote       String?
  position           Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([projectId, position])
}

model WebsiteTestimonial {
  id              String         @id @default(cuid())
  projectId       String
  project         WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerName    String
  testimonialText String
  serviceType     String?
  locationNote    String?
  rating          Int?
  position        Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([projectId, position])
}

model WebsiteService {
  id          String         @id @default(cuid())
  name        String
  description String         @default("")
  notes       String?
  position    Int
  projectId   String
  project     WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
}
