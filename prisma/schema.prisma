generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
}

enum MediaType {
  IMAGE
  VIDEO
}

model WebsiteProject {
  id                  String        @id @default(cuid())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  businessName        String
  businessType        String
  businessDescription String
  businessStory       String?
  targetAudience      String?
  differentiators     String?
  customerPriorities  String?
  factualNotes        String?
  serviceArea         String
  phone               String
  email               String
  yearsInBusiness     Int?
  brandTone           String
  primaryCallToAction String
  secondaryCallToAction String?
  visualStyle         String
  slug                String        @unique
  status              ProjectStatus @default(DRAFT)
  generatedContent    Json?
  contentGeneratedAt  DateTime?
  siteSettings        Json?
  isDemo              Boolean       @default(false)
  featured            Boolean       @default(false)
  demoTitle           String?
  demoDescription     String?
  demoSortOrder       Int?
  services            WebsiteService[]
  workSamples         WebsiteWorkSample[]
  testimonials        WebsiteTestimonial[]
}

model WebsiteWorkSample {
  id              String        @id @default(cuid())
  projectId       String
  project         WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaType       MediaType
  mediaUrl        String
  cloudinaryPublicId String?
  width           Int?
  height          Int?
  duration        Float?
  format          String?
  bytes           Int?
  title           String
  description     String
  serviceCategory String?
  locationNote    String?
  position        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([projectId, position])
}

model WebsiteTestimonial {
  id              String        @id @default(cuid())
  projectId       String
  project         WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerName    String
  testimonialText String
  serviceType     String?
  locationNote    String?
  rating          Int?
  position        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([projectId, position])
}

model WebsiteService {
  id        String         @id @default(cuid())
  name      String
  description String @default("")
  notes     String?
  position  Int
  projectId String
  project   WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
}
